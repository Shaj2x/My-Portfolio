{
  "name": "Digital Dash",
  "short_name": "Dash",
  "description": "Clocks, focus timers, tasks, calendar and net worth in one customizable dashboard.",
  "id": "/digital-dash.html",
  "start_url": "/digital-dash.html",
  "scope": "/digital-dash",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#141220",
  "theme_color": "#141220",
  "icons": [
    { "src": "/digital-dash-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/digital-dash-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/digital-dash-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tasks", "url": "/digital-dash.html#tasks" },
    { "name": "Week review", "url": "/digital-dash.html#week" },
    { "name": "Calendar", "url": "/digital-dash.html#calendar" }
  ]
}
