# Supabase project (Project Settings → API). Publishable = the anon/public key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used to send staff/driver/admin invites. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public URL of this app, used in auth email links. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:frontdesk@themarq.ca

# Email via Resend (optional; without it, email notifications are skipped).
RESEND_API_KEY=
EMAIL_FROM=The Marq <frontdesk@themarq.ca>

# Shared secrets: /api/cron/tick (Vercel Cron, automation engine) and
# /api/internal/* (Go and Python services).
CRON_SECRET=
INTERNAL_API_SECRET=

# Analytics API (stage 8) — server-side only.
ANALYTICS_URL=http://localhost:8000
ANALYTICS_API_KEY=

# Map tiles. Defaults to OpenStreetMap; use a Mapbox/MapTiler URL in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
