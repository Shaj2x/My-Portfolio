# Copy to infra/.env. Used by docker compose.

# Supabase Postgres (Project Settings → Database → connection string, session mode).
SUPABASE_DB_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# TimescaleDB (runs in compose).
TIMESCALE_PASSWORD=change-me

# MQTT service accounts — run mosquitto/make-passwords.sh after setting these.
MQTT_INGEST_PASSWORD=change-me
MQTT_AUTOMATION_PASSWORD=change-me
MQTT_SIMULATOR_PASSWORD=change-me

# Web app, for notification delivery and the once-a-minute tick.
APP_URL=https://marq-living.vercel.app
INTERNAL_API_SECRET=change-me
CRON_SECRET=change-me

# Analytics API key (the web app sends it as ANALYTICS_API_KEY).
ANALYTICS_API_KEY=change-me
